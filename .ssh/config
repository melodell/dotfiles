Host github.com
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_ed25519

# SSH multiplexing
#
# To avoid long file names when connecting to AWS: ControlPath ~/.ssh/socket-%C
Host *
  ControlMaster auto
  ControlPersist yes
  ControlPath ~/.ssh/socket-%C
  ServerAliveInterval 60
  ServerAliveCountMax 5
Host *-verkada.verkada.sandboxes.site
  ProxyCommand /Users/melina.odell/.crafting/sandbox/cli/current/bin/cs ssh-proxy %h:443
  UserKnownHostsFile /Users/melina.odell/.crafting/sandbox/known_hosts
  User owner
  StrictHostKeyChecking yes
  HashKnownHosts no
  IdentityFile /Users/melina.odell/.crafting/sandbox/id_client
